{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "LogBrew",
  "description": "Agent-first observability for developers. Read logs, traces, issues, actions, and releases from the native LogBrew CLI and API.",
  "colors": {
    "primary": "#3C2B24",
    "light": "#F4C914",
    "dark": "#8E8E93"
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Outfit",
    "source": "/fonts/Outfit-Variable.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/logbrew-logo-transparent-512.png",
    "dark": "/logo/logbrew-logo-transparent-512.png",
    "href": "https://logbrew.co"
  },
  "favicon": "/favicon-512.png",
  "navbar": {
    "links": [
      {
        "label": "Website",
        "icon": "globe",
        "href": "https://logbrew.co"
      },
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/LogBrewCo"
      }
    ]
  },
  "search": {
    "prompt": "Search LogBrew docs"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Start",
            "icon": "rocket",
            "pages": ["introduction", "quickstart"]
          },
          {
            "group": "Concepts",
            "icon": "compass",
            "pages": [
              "concepts/telemetry",
              "concepts/releases",
              "concepts/projects",
              "concepts/mobile-app"
            ]
          },
          {
            "group": "Install and send",
            "icon": "cloud-upload",
            "pages": [
              "guides/sdk-ingestion",
              "guides/flask",
              "guides/apple-crashes-and-hangs"
            ]
          },
          {
            "group": "Investigate",
            "icon": "search",
            "pages": [
              "guides/issue-workflow",
              "guides/investigate-an-issue",
              "guides/troubleshooting"
            ]
          },
          {
            "group": "CLI and agents",
            "icon": "square-terminal",
            "pages": ["guides/cli", "guides/ai-agents"]
          },
          {
            "group": "Support",
            "icon": "life-buoy",
            "pages": ["guides/report-a-problem"]
          }
        ]
      },
      {
        "tab": "Reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Reference",
            "icon": "book-open",
            "pages": [
              "reference/terminology",
              "reference/cli",
              "reference/telemetry-api",
              "reference/telemetry-api-filters",
              "reference/api-errors",
              "reference/telemetry-response-shapes",
              "reference/account-api"
            ]
          }
        ]
      },
      {
        "tab": "Docs for agents",
        "icon": "bot",
        "href": "https://logbrew.co/llms.txt"
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/LogBrewCo"
    }
  },
  "metadata": {
    "og:site_name": "LogBrew Docs",
    "og:type": "website",
    "og:description": "Docs for LogBrew, the agent-first observability CLI and API for logs, traces, issues, actions, and releases.",
    "twitter:card": "summary_large_image"
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "redirects": [
    {
      "source": "/concepts/feed-and-events",
      "destination": "/concepts/telemetry"
    },
    {
      "source": "/concepts/logs",
      "destination": "/concepts/telemetry"
    },
    {
      "source": "/concepts/notifications",
      "destination": "/concepts/mobile-app"
    },
    {
      "source": "/features/live-feed",
      "destination": "/concepts/mobile-app"
    },
    {
      "source": "/features/resolve-sync",
      "destination": "/guides/issue-workflow"
    },
    {
      "source": "/features/saved-filters",
      "destination": "/guides/cli"
    },
    {
      "source": "/features/sharing",
      "destination": "/guides/issue-workflow"
    },
    {
      "source": "/integrations/:provider",
      "destination": "/guides/sdk-ingestion"
    },
    {
      "source": "/integrations/overview",
      "destination": "/guides/sdk-ingestion"
    },
    {
      "source": "/reference/telemetry-data",
      "destination": "/reference/telemetry-response-shapes"
    },
    {
      "source": "/settings/account",
      "destination": "/quickstart"
    },
    {
      "source": "/settings/notifications",
      "destination": "/concepts/mobile-app"
    }
  ],
  "contextual": {
    "display": "header",
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  }
}
